    {
      "parameters": {
        "jsCode": "function obtenerAnalisis() {\n  try {\n    const principal = $('Agente Analisis Tarifas').item.json;\n    if (principal && principal.output) return principal.output;\n  } catch (e) {}\n  try {\n    const respaldo = $('Agente Analisis Tarifas (Fallback)').item.json;\n    if (respaldo && respaldo.output) return respaldo.output;\n  } catch (e) {}\n  throw new Error('Ni el agente principal ni el de respaldo de analisis produjeron una salida valida.');\n}\n\nconst analisis = obtenerAnalisis();\nconst parametros = $('Combinar Métricas y Parámetros').item.json.parametros_vigentes;\nconst ajustes = analisis.ajustes_propuestos || [];\nconst comentarios = $json['Comentarios'] ?? null;\n\nfunction calcularTarifa(p, ajuste) {\n  let { base_fare, distance_fare, time_fare, longdistance_fare, fuel_surcharge, tarifa_minima } = p;\n  base_fare = Number(base_fare); distance_fare = Number(distance_fare); time_fare = Number(time_fare);\n  longdistance_fare = Number(longdistance_fare); fuel_surcharge = Number(fuel_surcharge); tarifa_minima = Number(tarifa_minima);\n  let componente_ajustado = null, ajuste_pct = null;\n  if (ajuste) {\n    componente_ajustado = ajuste.componente_ajustado;\n    ajuste_pct = ajuste.ajuste_pct;\n    const factor = 1 + (ajuste_pct / 100);\n    if (componente_ajustado === 'base_fare') base_fare = base_fare * factor;\n    else if (componente_ajustado === 'distance_fare') distance_fare = distance_fare * factor;\n    else if (componente_ajustado === 'time_fare') time_fare = time_fare * factor;\n    else if (componente_ajustado === 'longdistance_fare') longdistance_fare = longdistance_fare * factor;\n    else if (componente_ajustado === 'fuel_surcharge') fuel_surcharge = fuel_surcharge * factor;\n  }\n  const suma = base_fare + distance_fare + time_fare + longdistance_fare + fuel_surcharge;\n  const tarifa_calculada = Math.max(tarifa_minima, suma);\n  return { base_fare, distance_fare, time_fare, longdistance_fare, fuel_surcharge, tarifa_minima, tarifa_calculada, componente_ajustado, ajuste_pct };\n}\n\nconst filas = parametros.map(p => {\n  const ajuste = ajustes.find(a => a.codigo_ciudad === p.codigo_ciudad && a.codigo_producto === p.codigo_producto);\n  const calculo = calcularTarifa(p, ajuste);\n  return {\n    json: {\n      codigo_ciudad: p.codigo_ciudad,\n      nombre_ciudad: ajuste ? ajuste.nombre_ciudad : null,\n      codigo_producto: p.codigo_producto,\n      hora_inicio: ajuste ? ajuste.hora_inicio : null,\n      hora_fin: ajuste ? ajuste.hora_fin : null,\n      cr_observado: ajuste ? ajuste.cr_observado : null,\n      resumen: analisis.resumen,\n      riesgo_principal: analisis.riesgo_principal,\n      anomalias: JSON.stringify(analisis.anomalias || []),\n      recomendaciones: JSON.stringify(analisis.recomendaciones || []),\n      aprobado_por_comentarios: comentarios || 'Auto-aprobado: sin anomalias detectadas por el agente',\n      ...calculo\n    }\n  };\n});\nreturn filas;"
      },

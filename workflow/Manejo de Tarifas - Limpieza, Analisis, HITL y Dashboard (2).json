      "parameters": {
        "jsCode": "const metricas = $input.all().map(i => i.json);\nconst parametros = $('Consultar Parámetros Vigentes').all().map(i => i.json);\nreturn [{ json: { metricas, parametros_vigentes: parametros } }];"
